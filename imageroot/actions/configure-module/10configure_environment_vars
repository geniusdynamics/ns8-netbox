import json
import os
import sys
import agent

request = json.load(sys.stdin)
host = request["host"]

# One TCP port: the NetBox web server (port 8080 in the pod)
agent.set_env("TCP_PORT", os.environ["TCP_PORTS"].split(",")[0])

# Mail goes through the cluster smarthost, when one is configured
rdb = agent.redis_connect(use_replica=True)
smtp = agent.get_smarthost_settings(rdb)
mail = {}
if smtp.get("enabled") and smtp.get("host"):
    mail = {
        "EMAIL_SERVER": smtp["host"],
        "EMAIL_PORT": smtp["port"],
        "EMAIL_USERNAME": smtp["username"],
        "EMAIL_FROM": smtp["username"] or f"netbox@{host}",
        "EMAIL_USE_TLS": "true" if smtp.get("encrypt_smtp") == "starttls" else "false",
        "EMAIL_USE_SSL": "true" if smtp.get("encrypt_smtp") == "tls" else "false",
    }

# Settings of the netbox-docker image that are not secret. The secrets come
# from passwords.env, see the netbox-app and netbox-worker units. All the
# containers share the pod network: services are reached on 127.0.0.1.
agent.write_envfile("netbox-app.env", {
    "DB_HOST": "127.0.0.1",
    "DB_NAME": "netbox",
    "DB_USER": "netbox",
    "REDIS_HOST": "127.0.0.1",
    "REDIS_PORT": "6379",
    "REDIS_DATABASE": "0",
    "REDIS_SSL": "false",
    "REDIS_CACHE_HOST": "127.0.0.1",
    "REDIS_CACHE_PORT": "6380",
    "REDIS_CACHE_DATABASE": "1",
    "REDIS_CACHE_SSL": "false",
    "ALLOWED_HOSTS": "*",
    "CSRF_TRUSTED_ORIGINS": f"https://{host}",
    "GRAPHQL_ENABLED": "true",
    "METRICS_ENABLED": "false",
    "MEDIA_ROOT": "/opt/netbox/netbox/media",
    "SKIP_SUPERUSER": "false",
    "SUPERUSER_NAME": "admin",
    "SUPERUSER_EMAIL": f"admin@{host}",
    "RELEASE_CHECK_URL": "",
    **mail,
})

agent.write_envfile("postgres.env", {
    "POSTGRES_DB": "netbox",
    "POSTGRES_USER": "netbox",
    "TZ": "UTC",
})
