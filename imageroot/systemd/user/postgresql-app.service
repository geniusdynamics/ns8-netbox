[Unit]
Description=Podman postgresql-app.service
BindsTo=netbox.service
After=netbox.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=%E/state/passwords.env
# EnvironmentFile=%E/state/secrets/passwords.secret
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/postgresql-app.pid %t/postgresql-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postgresql-app.pid \
    --cidfile %t/postgresql-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/netbox.pod-id --replace -d --name postgresql-app \
    --env-file=%E/state/postgres.env \
    --env=POSTGRES_PASSWORD=${NETBOX_DB_PASSWORD} \
    --volume postgres-data:/var/lib/postgresql:Z \
    ${POSTGRES_IMAGE}
ExecStartPost=/usr/bin/bash -c "while ! podman exec postgresql-app pg_isready -U netbox -d netbox; do sleep 2; done"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postgresql-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postgresql-app.ctr-id
ExecReload=/usr/bin/podman kill -s HUP postgresql-app
SyslogIdentifier=%u
PIDFile=%t/postgresql-app.pid
Type=forking

[Install]
WantedBy=default.target
