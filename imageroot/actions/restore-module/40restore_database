set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

# The backup holds passwords.env: restore the database with the same password.
# Do not source the file: the other secrets hold shell metacharacters.
NETBOX_DB_PASSWORD=$(grep -m1 '^NETBOX_DB_PASSWORD=' passwords.env | cut -d= -f2-)
printf "POSTGRES_DB=netbox\nPOSTGRES_USER=netbox\nTZ=UTC\n" > postgres.env

mkdir -vp restore
cat - >restore/netbox_restore.sh <<'EOS'
# Read dump file from standard input:
pg_restore --no-owner --no-privileges -U netbox -d netbox
ec=$?
docker_temp_server_stop
exit $ec
EOS

# Override the image /docker-entrypoint-initdb.d contents, to restore the
# DB dump file. The container will be stopped at the end

podman run \
    --rm \
    --interactive \
    --network=none \
    --volume=./restore:/docker-entrypoint-initdb.d/:Z \
    --volume=postgres-data:/var/lib/postgresql:Z \
    --replace --name=restore_db \
    --env-file=postgres.env \
    --env POSTGRES_PASSWORD="${NETBOX_DB_PASSWORD}" \
    "${POSTGRES_IMAGE}" < netbox.pg_dump

# If the restore is successful, clean up:
rm -rfv restore/ netbox.pg_dump