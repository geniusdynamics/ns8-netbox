import os
import secrets
import string

# Secrets of the instance, generated once. They must not go through
# agent.set_env(): the module environment is stored in Redis, and names
# such as REDIS_PASSWORD there are the module agent's own credentials.
# Keep them in a private file, loaded by the systemd units and included
# in the module backup.
alphabet = string.ascii_letters + string.digits + "!@#%^*()-_=+"
values = {
    "NETBOX_DB_PASSWORD": secrets.token_hex(16),
    "NETBOX_REDIS_PASSWORD": secrets.token_hex(16),
    "NETBOX_REDIS_CACHE_PASSWORD": secrets.token_hex(16),
    "NETBOX_SECRET_KEY": "".join(secrets.choice(alphabet) for _ in range(60)),
    "NETBOX_API_TOKEN_PEPPER_1": "".join(secrets.choice(alphabet) for _ in range(60)),
    "NETBOX_SUPERUSER_PASSWORD": secrets.token_urlsafe(12),
}
path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    for key, value in values.items():
        fp.write(f"{key}={value}\n")
