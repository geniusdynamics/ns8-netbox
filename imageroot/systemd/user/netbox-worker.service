[Unit]
Description=Podman netbox-worker.service
BindsTo=netbox.service
After=netbox.service postgresql-app.service redis-app.service redis-cache-app.service netbox-app.service

# The rqworker needs the database schema: it waits, inside the container,
# until netbox-app has applied the migrations and serves pages. Crashing
# instead would restart the whole pod: netbox.service Requires= this unit,
# and systemd propagates its automatic restarts to the pod, which kills
# netbox-app in the middle of the migrations.

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# NETBOX_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p config
ExecStartPre=/bin/rm -f %t/netbox-worker.pid %t/netbox-worker.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/netbox-worker.pid \
    --cidfile %t/netbox-worker.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/netbox.pod-id --replace -d --name  netbox-worker \
    --env-file=%E/state/netbox-app.env \
    --env=DB_PASSWORD=${NETBOX_DB_PASSWORD} \
    --env=REDIS_PASSWORD=${NETBOX_REDIS_PASSWORD} \
    --env=REDIS_CACHE_PASSWORD=${NETBOX_REDIS_CACHE_PASSWORD} \
    --env=SECRET_KEY=${NETBOX_SECRET_KEY} \
    --env=API_TOKEN_PEPPER_1=${NETBOX_API_TOKEN_PEPPER_1} \
    --env=SUPERUSER_PASSWORD=${NETBOX_SUPERUSER_PASSWORD} \
    --volume netbox-media-files:/opt/netbox/netbox/media:z \
    --volume netbox-reports-files:/opt/netbox/netbox/reports:z \
    --volume netbox-scripts-files:/opt/netbox/netbox/scripts:z \
    ${NETBOX_IMAGE} \
    /bin/bash -c "until /opt/netbox/health.sh; do echo 'Waiting for the NetBox migrations...'; sleep 10; done; exec /opt/netbox/venv/bin/python /opt/netbox/netbox/manage.py rqworker"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/netbox-worker.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP netbox-worker
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/netbox-worker.ctr-id
PIDFile=%t/netbox-worker.pid
Type=forking

[Install]
WantedBy=default.target
